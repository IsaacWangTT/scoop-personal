            "hash": "8badd6ea85e4b3c7123f27947ed360c2a09d8c879c023326dbdc5869920e65be"
        },
        "arm64": {
            "url": "https://github.com/MiChongs/sing-box/releases/download/v1.15.0-alpha.13-xiaobaf14g.17/sing-box-1.15.0-alpha.13-xiaobaf14g.17-windows-arm64.tar.gz",
            "hash": "a315ba8ff48c38f6d1e0e3cdbf2dc1c3119cc65aee79c316b3bfe53fd79be9b1"
        }
    },
    "pre_install": [
        "$exe = @(Get-ChildItem -LiteralPath $dir -File -Filter \"sing-box-$version-windows-*.exe\")",
        "if ($exe.Count -ne 1) { throw 'Expected exactly one versioned sing-box executable in the archive root.' }",
        "Rename-Item -LiteralPath $exe[0].FullName -NewName 'sing-box.exe' -ErrorAction Stop",
        "if (!(Test-Path -LiteralPath $persist_dir)) { New-Item -Path $persist_dir -ItemType Directory -ErrorAction Stop | Out-Null }",
        "if (!(Test-Path -LiteralPath \"$persist_dir\\config.json\")) { [System.IO.File]::WriteAllText(\"$persist_dir\\config.json\", \"{}`n\", (New-Object System.Text.UTF8Encoding($false))) }",
        "if (!(Test-Path -LiteralPath \"$persist_dir\\cache.db\")) { New-Item -Path \"$persist_dir\\cache.db\" -ItemType File -ErrorAction Stop | Out-Null }"
    ],
    "bin": [["sing-box.exe", "sing-box-michongs-beta"]],
    "persist": ["config", "config.d", "config.json", "cache.db"],
    "checkver": {
        "url": "https://api.github.com/repos/MiChongs/sing-box/releases?per_page=100",
        "jsonpath": "$[?(@.prerelease == true)].tag_name",
        "regex": "v(\\d+\\.\\d+\\.\\d+(?:-[A-Za-z0-9.-]+)?-xiaobaf14g\\.\\d+)\\b"
    },
    "autoupdate": {
        "architecture": {
            "64bit": { "url": "https://github.com/MiChongs/sing-box/releases/download/v$version/sing-box-$version-windows-amd64-v3.tar.gz" },
            "arm64": { "url": "https://github.com/MiChongs/sing-box/releases/download/v$version/sing-box-$version-windows-arm64.tar.gz" }
        },
        "hash": { "url": "$baseurl/SHA256SUMS" }
    }
}
