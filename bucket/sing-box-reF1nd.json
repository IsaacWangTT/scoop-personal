{
    "version": "1.14.3",
    "description": "The universal proxy platform, sing-box with custom APIs by reF1nd",
    "homepage": "https://github.com/reF1nd/sing-box",
    "license": "GPL-3.0-or-later",
    "notes": [
        "Run with a config file: sing-box run -c <config.json> (the executable is still sing-box.exe)",
        "This build includes custom control APIs by reF1nd, see https://github.com/reF1nd/sing-box for details.",
        "Pin this version against auto-updates with: scoop hold sing-box-reF1nd"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/reF1nd/sing-box-releases/releases/download/v1.14.3-reF1nd/sing-box-1.14.3-reF1nd-windows-amd64v3.zip",
            "hash": "38401990d2f5dfcee3a32ddc88910b494ae810787a6a898e7a6737c5f3d1df3b",
            "extract_dir": "sing-box-1.14.3-reF1nd-windows-amd64v3"
        },
        "arm64": {
            "url": "https://github.com/reF1nd/sing-box-releases/releases/download/v1.14.3-reF1nd/sing-box-1.14.3-reF1nd-windows-arm64.zip",
            "hash": "bbe69e8d2c66f3c0f734583329a9455b28b273076b2cc68626c5a79e4a535869",
            "extract_dir": "sing-box-1.14.3-reF1nd-windowsv3-arm64"
        }
    },
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\")) { New-Item -Path \"$persist_dir\" -ItemType Directory | Out-Null }",
        "if (!(Test-Path \"$persist_dir\\config.json\")) {",
        "   $utf8NoBom = New-Object System.Text.UTF8Encoding($false)",
        "   [System.IO.File]::WriteAllText(\"$persist_dir\\config.json\", \"{}`n\", $utf8NoBom)",
        "}",
        "if (!(Test-Path \"$persist_dir\\cache.db\")) { New-Item -Path \"$persist_dir\\cache.db\" -ItemType File | Out-Null }"
    ],
    "bin": "sing-box.exe",
    "persist": [
        "config",
        "config.d",
        "config.json",
        "cache.db"
    ],
    "checkver": {
        "github": "https://github.com/reF1nd/sing-box-releases",
        "regex": "v([\\d.]+)-reF1nd$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/reF1nd/sing-box-releases/releases/download/v$version-reF1nd/sing-box-$version-reF1nd-windows-amd64v3.zip",
                "extract_dir": "sing-box-$version-reF1nd-windows-amd64v3"
            },
            "arm64": {
                "url": "https://github.com/reF1nd/sing-box-releases/releases/download/v$version-reF1nd/sing-box-$version-reF1nd-windows-arm64.zip",
                "extract_dir": "sing-box-$version-reF1nd-windowsv3-arm64"
            }
        }
    }
}
